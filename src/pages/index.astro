---
import Base from '../layouts/Base.astro';
import RecordList from '../components/RecordList.astro';
import { CHAPTERS } from '../data/chapters.js';
import { HOME, isPublic } from '../gate.js';

// Only chapters that are on this build are linked.
const chapters = CHAPTERS.map((c) => (c.href && !isPublic(c.href) ? { ...c, href: undefined } : c));
---
<Base section="home">
  <div class="hero">
    <span class="label">A documented history · Yemen, 1992 to the present</span>
    <h1>How a movement from Saada <em>took a state</em>, and what it has done with it.</h1>
    <p>The story of Ansar Allah, known as the Houthis, told in order and in full: where it came from, what it believes in its own words, how it took power and how it rules.</p>
  </div>

  {!HOME.chapters && (
    <>
      <hr class="rule">
      <section class="two" aria-labelledby="prep">
        <span class="label" id="prep">In preparation</span>
        <div class="note">
          <p>The first chapters are in preparation.</p>
          {!HOME.why && <p><a href="/charter/">Read the charter →</a></p>}
        </div>
      </section>
    </>
  )}

  {HOME.why && (
    <>
      <hr class="rule">
      <section class="two" aria-labelledby="method">
        <span class="label" id="method">Why this record</span>
        <div class="note">
          <p>The Houthi movement has ruled Yemen's capital since 2014. Most of what is written about it concerns the war: a strike, a ceasefire, a ship in the Red Sea.</p>
          <p>This record tells the movement's story from the beginning: its origins in Saada, its beliefs in its own words, how it took power, how it governs and how it fights. Its founding texts and speeches are published in full, in Arabic and English.</p>
          <p><a href="/charter/">Read the charter →</a></p>
        </div>
      </section>
    </>
  )}

  {HOME.chapters && (
    <>
      <hr class="rule">
      <section class="two" aria-labelledby="how">
        <span class="label" id="how">How to read this record</span>
        <div class="layers" style="grid-template-columns:repeat(2,minmax(0,1fr))">
          <div class="layer">
            <h3>Documented</h3>
            <p>Numbered sources follow the facts they support. The full list is at the end of each chapter.</p>
          </div>
          <div class="layer">
            <h3><span class="sym" aria-hidden="true">□</span>Testimony</h3>
            <p>An eyewitness account, published under a pseudonym and set apart in a marked box.</p>
          </div>
        </div>
      </section>

      <hr class="rule">

      <section class="two" aria-labelledby="ch">
        <span class="label" id="ch">Chapters</span>
        <RecordList items={chapters} />
      </section>
    </>
  )}
</Base>
