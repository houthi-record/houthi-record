---
import Base from '../layouts/Base.astro';
import RecordList from '../components/RecordList.astro';
import { DOCUMENTS } from '../data/chapters.js';
---
<Base title="Documents" description="Primary documents of the Houthi movement: the Malazem, speeches, decrees and agreements, in Arabic and English." section="documents">
  <div class="page-head">
    <span class="label">Primary documents · planned archive</span>
    <h1>In their own words</h1>
    <p>The movement's founding texts, speeches and decrees, published in full in the original Arabic with an English translation and notes on context. Readers can judge the source directly instead of relying on anyone's summary, including ours.</p>
  </div>
  <RecordList items={DOCUMENTS} />
  <div class="note" style="margin-top:2.5rem">
    <p>Each document will carry its provenance: where the copy came from, which edition, and how its authenticity was checked. Documents that name private individuals are redacted to protect them.</p>
  </div>
</Base>
