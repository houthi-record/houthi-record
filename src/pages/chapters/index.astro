---
import Base from '../../layouts/Base.astro';
import RecordList from '../../components/RecordList.astro';
import { CHAPTERS } from '../../data/chapters.js';
import { isPublic } from '../../gate.js';
const items = CHAPTERS.map((c) => (c.href && !isPublic(c.href) ? { ...c, href: undefined } : c));
---
<Base title="Chapters" description="The history of the Houthi movement, in order, from its roots in Saada to the present." section="chapters">
  <div class="page-head">
    <span class="label">Chapters</span>
    <h1>The story, in order</h1>
    <p>The movement's history in order, from its roots to the present.</p>
  </div>
  <RecordList items={items} />
</Base>
