---
// The expansion map. Places plotted by coordinates; no borders, areas or grid.
// One step is active at a time; the window beside the map shows the previous,
// active and next steps. Data: src/data/expansion.json.
import DATA from '../data/expansion.json';

const LON0 = 42.5, LON1 = 45.7, LAT0 = 12.4, LAT1 = 17.2;
const K = 112, PAD = 28;
const W = Math.round((LON1 - LON0) * K + PAD * 2);
const H = Math.round((LAT1 - LAT0) * K + PAD * 2);
const xy = (p) => [Math.round(PAD + (p.lon - LON0) * K), Math.round(PAD + (LAT1 - p.lat) * K)];

const steps = DATA.steps.map((s, i) => {
  const [x, y] = xy(DATA.places[s.place]);
  const f = s.from ? xy(DATA.places[s.from]) : null;
  return { ...s, i, x, y, name: DATA.places[s.place].name, fx: f && f[0], fy: f && f[1] };
});
const last = steps.length - 1;
const STATUS = { held: 'Still held', lost: 'Taken, then lost', contested: 'Contested', attacked: 'Attacked, not taken' };
const anchor = { dammaj: ['start', 10, 14], saada: ['start', 10, -6], marran: ['end', -10, -6], marib: ['end', -10, -8], mokha: ['end', -10, 4], hodeidah: ['end', -10, 4] };
const card = (s, role) => s ? { ...s, role } : null;
const initial = [card(steps[last - 1], 'prev'), card(steps[last], 'cur'), null];
---
<figure class="xmap" aria-labelledby="xmap-cap" data-steps={JSON.stringify(steps.map(({ i, date, title, text, status, sources }) => ({ i, date, title, text, status: STATUS[status], sources })))}>
  <div class="xmap-grid">
    <div class="xmap-map">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="xmap-title">
        <title id="xmap-title">Map of the Houthi movement's expansion from Marran to the Bab al-Mandab strait, 2002 to 2026, with places plotted by coordinates</title>
        {steps.filter((s) => s.fx != null).map((s) => <line class="seg" data-step={s.i} x1={s.fx} y1={s.fy} x2={s.x} y2={s.y} />)}
        {steps.map((s) => {
          const a = anchor[s.place] || ['start', 10, 4];
          return (
            <g class={`pt st-${s.status}${s.i === last ? ' cur' : ''}`} data-step={s.i}>
              <circle class="halo" cx={s.x} cy={s.y} r="11" />
              {s.place === 'sanaa' ? <rect class="mk" x={s.x - 5} y={s.y - 5} width="10" height="10" /> : <circle class="mk" cx={s.x} cy={s.y} r="4.5" />}
              <text x={s.x + a[1]} y={s.y + a[2]} text-anchor={a[0]}>{s.name}</text>
            </g>
          );
        })}
      </svg>
    </div>

    <div class="xmap-side">
      <div class="xmap-ctl" role="group" aria-label="Move through the map">
        <button type="button" data-dir="-1" aria-label="Previous step">←</button>
        <span class="label" aria-live="polite"><span data-count>{last + 1}</span> / {steps.length}</span>
        <button type="button" data-dir="1" aria-label="Next step">→</button>
        <button type="button" data-all aria-pressed="false">Show all</button>
      </div>
      <ol class="xmap-win" aria-label="Steps">
        {initial.map((c, k) => (
          <li class={['prev', 'cur', 'next'][k]} hidden={!c}>
            <button type="button" data-go={c ? c.i : ''} tabindex={k === 1 ? -1 : 0}>
              <span class="d">{c ? c.date : ''}</span>
              <span class="t">{c ? c.title : ''}</span>
            </button>
            <div class="xmap-detail">
              <p>{c ? c.text : ''}</p>
              <span class="meta"><span class="st">{c ? STATUS[c.status] : ''}</span><span class="src">{c && c.sources.map((src) => <a href={src.url}>{src.label}</a>)}</span></span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <figcaption id="xmap-cap">
    <span class="label">Map · Expansion, 2002–2026</span>
    <span>Places are plotted by latitude and longitude. Borders, coastline and areas of control are not drawn. Each line joins a place to the one the advance came from. Filled marks are still held; open marks were lost or are contested. Marran's position is approximate.</span>
  </figcaption>
</figure>

<style>
  .xmap { margin: 0 0 3.5rem; border-block: 1px solid var(--rule); padding-block: 1.75rem; }
  .xmap-grid { display: grid; grid-template-columns: minmax(0, 24rem) minmax(0, 1fr); gap: 3rem; align-items: center; }
  .xmap svg { width: 100%; height: auto; display: block; overflow: visible; }
  .seg { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 3 4; transition: opacity .25s, stroke .25s; }
  .seg.cur { stroke: var(--accent); stroke-dasharray: none; stroke-width: 1.5; }
  .pt .mk { fill: var(--ink); stroke: var(--ink); stroke-width: 1.2; transition: fill .25s, stroke .25s; }
  .pt.st-lost .mk, .pt.st-contested .mk, .pt.st-attacked .mk { fill: var(--paper); }
  .pt text { font-family: var(--serif); font-size: 14px; fill: var(--ink); transition: fill .25s; }
  .pt .halo { fill: none; stroke: none; }
  .pt.cur .mk { fill: var(--accent); stroke: var(--accent); }
  .pt.cur .halo { stroke: var(--accent); stroke-width: 1; opacity: .5; }
  .pt.cur text { font-weight: 500; }
  .pt.dim, .seg.dim { opacity: .14; }
  .xmap-ctl { display: flex; align-items: center; gap: .75rem; margin-bottom: 1.25rem; }
  .xmap-ctl button { font-family: var(--mono); font-size: .75rem; background: none; color: var(--ink); border: 1px solid var(--rule); padding: .35rem .7rem; cursor: pointer; }
  .xmap-ctl button[aria-pressed="true"] { border-color: var(--ink); }
  .xmap-ctl button:disabled { opacity: .35; cursor: default; }
  .xmap-win { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .xmap-win li { border-bottom: 1px solid var(--rule); }
  .xmap-win li > button { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1rem; width: 100%; text-align: left; background: none; border: 0; padding: .7rem 0; cursor: pointer; color: inherit; font: inherit; }
  .xmap-win .d { font-family: var(--mono); font-size: .75rem; color: var(--ink-3); padding-top: .25rem; }
  .xmap-win .t { font-size: 1.05rem; }
  .xmap-win li.prev, .xmap-win li.next { color: var(--ink-3); }
  .xmap-win li.prev .xmap-detail, .xmap-win li.next .xmap-detail { display: none; }
  .xmap-win li.cur > button { cursor: default; }
  .xmap-win li.cur .t { font-size: 1.3rem; color: var(--ink); }
  .xmap-win li.cur .d { color: var(--accent); }
  .xmap-detail { padding: 0 0 1rem 7.5rem; display: grid; gap: .45rem; }
  .xmap-detail p { font-size: 1rem; color: var(--ink-2); }
  .xmap-detail .meta { display: flex; gap: .9rem; flex-wrap: wrap; font-family: var(--mono); font-size: .6875rem; color: var(--ink-3); }
  .xmap-detail .src { display: flex; gap: .9rem; flex-wrap: wrap; }
  .xmap figcaption { font-size: .9rem; color: var(--ink-2); margin-top: 1.5rem; display: grid; gap: .3rem; max-width: 46rem; }
  @media (prefers-reduced-motion: reduce) { .seg, .pt .mk, .pt text { transition: none; } }
  @media (max-width: 820px) {
    .xmap-grid { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
    .xmap-map { max-width: 15rem; margin: 0 auto; width: 100%; }
    .xmap-detail { padding-left: 0; }
    .xmap-win li > button { grid-template-columns: 5.5rem minmax(0, 1fr); }
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('.xmap').forEach(function (fig) {
      var steps = JSON.parse(fig.dataset.steps);
      var n = steps.length, cur = n - 1, all = false;
      var marks = fig.querySelectorAll('.pt, .seg');
      var lis = fig.querySelectorAll('.xmap-win li');
      var counter = fig.querySelector('[data-count]');
      var prevB = fig.querySelector('[data-dir="-1"]'), nextB = fig.querySelector('[data-dir="1"]');
      var allB = fig.querySelector('[data-all]');
      function fill(li, s) {
        li.hidden = !s;
        if (!s) return;
        var b = li.querySelector('button');
        b.dataset.go = s.i;
        li.querySelector('.d').textContent = s.date;
        li.querySelector('.t').textContent = s.title;
        li.querySelector('.xmap-detail p').textContent = s.text;
        li.querySelector('.st').textContent = s.status;
        var src = li.querySelector('.src');
        src.replaceChildren();
        s.sources.forEach(function (x) { var a = document.createElement('a'); a.href = x.url; a.textContent = x.label; a.target = '_blank'; a.rel = 'noopener noreferrer'; src.append(a); });
      }
      function render() {
        marks.forEach(function (m) {
          var i = +m.dataset.step;
          m.classList.toggle('dim', !all && i > cur);
          m.classList.toggle('cur', i === cur);
        });
        fill(lis[0], steps[cur - 1]);
        fill(lis[1], steps[cur]);
        fill(lis[2], steps[cur + 1]);
        counter.textContent = String(cur + 1);
        prevB.disabled = cur === 0; nextB.disabled = cur === n - 1;
        allB.setAttribute('aria-pressed', String(all));
      }
      function go(i) { cur = Math.max(0, Math.min(n - 1, i)); all = false; render(); }
      prevB.addEventListener('click', function () { go(cur - 1); });
      nextB.addEventListener('click', function () { go(cur + 1); });
      allB.addEventListener('click', function () { all = !all; render(); });
      lis[0].querySelector('button').addEventListener('click', function () { go(cur - 1); });
      lis[2].querySelector('button').addEventListener('click', function () { go(cur + 1); });
      fig.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { go(cur - 1); e.preventDefault(); }
        if (e.key === 'ArrowRight') { go(cur + 1); e.preventDefault(); }
      });
      cur = 0; render();
    });
  })();
</script>
